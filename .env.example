# Episteme-Network - Configuration des variables d'environnement
# Copiez ce fichier vers .env et remplissez vos clés API

# ============================================================
# CONFIGURATION LLM - API Keys
# ============================================================

# OpenAI API Key (optionnel si vous utilisez Ollama)
OPENAI_API_KEY=

# Groq API Key (https://console.groq.com)
GROQ_API_KEY=

# Mistral API Key (https://console.mistral.ai)
MISTRAL_API_KEY=

# Cerebras API Key (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# ============================================================
# CONFIGURATION LLM - Activation des services
# ============================================================

# Activer/désactiver les services (true/false)
USE_OLLAMA=true
USE_GROQ=false
USE_MISTRAL=false
USE_CEREBRAS=false

# ============================================================
# CONFIGURATION LLM - URLs et Modèles
# ============================================================

# Ollama (local)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral
MISTRAL_MODEL=mistral-large-latest
MISTRAL_API_URL=https://api.mistral.ai

# Cerebras
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# ============================================================
# PARAMETRES DE L'ALGORITHME
# ============================================================

# Profondeur maximale de récursion
MAX_DEPTH=15

# Nombre maximum de scientifiques à analyser
MAX_SCIENTISTS=1000

# Scientifique de départ
START_SCIENTIST=Albert Einstein

# Langue Wikipedia ('en' ou 'fr')
WIKIPEDIA_LANGUAGE=en
